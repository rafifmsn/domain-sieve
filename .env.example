# Data storage root (SQLite DB, sharded scraped JSONs, run metrics, exports)
DATA_DIR=data

# CertStream WebSocket URL (local certstream-server-go or compatible stream)
CERTSTREAM_URL=ws://127.0.0.1:8080/

# Classifier backend ("nli" for local MoritzLaurer/bge-m3-zeroshot-v2.0, "jev" for TypeSafe API)
SIEVE_CLASSIFIER=nli

# Optional until A/B eval or --classifier jev
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# Out-of-band DeepSeek Uncensored enricher (Netra Runtime / OpenAI-compatible)
DEEPSEEK_BASE_URL=https://api.netra.ai/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-uncensored
